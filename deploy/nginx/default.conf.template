resolver 127.0.0.11 valid=10s ipv6=off;
upstream helm_identity { zone helm_identity 64k; server keycloak:8080 resolve; }
upstream helm_auth { zone helm_auth 64k; server oauth2-proxy:4180 resolve; }
upstream helm_api { zone helm_api 64k; server api:8080 resolve; }
upstream helm_browser { zone helm_browser 64k; server browser-node:8090 resolve; }
upstream helm_frontend { zone helm_frontend 64k; server frontend:8080 resolve; }
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
map $http_x_forwarded_proto $public_scheme { default $scheme; https https; }
server {
    listen 8080;
    server_name ${PUBLIC_HOST};
    server_tokens off;
    client_max_body_size 16m;
    access_log off;
    error_log /dev/stderr crit;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    proxy_buffer_size 16k;
    proxy_buffers 4 16k;
    proxy_busy_buffers_size 32k;

    location = /health { return 200 'ok'; }
    location ^~ /auth/admin/ { return 404; }
    location ^~ /auth/realms/master/ { return 404; }
    location /auth/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $public_scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://helm_identity;
    }
    location = /oauth2/auth {
        internal;
        proxy_pass http://helm_auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_set_header X-Forwarded-Proto $public_scheme;
        proxy_set_header Host $host;
    }
    location /oauth2/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $public_scheme;
        proxy_set_header X-Auth-Request-Redirect ${PUBLIC_URL}/tasks;
        proxy_intercept_errors on;
        error_page 400 401 403 500 502 503 504 =303 ${PUBLIC_URL}/sign-in-error;
        proxy_pass http://helm_auth;
    }
    # RFC 8414 places the issuer path after the well-known name; Keycloak uses a suffix.
    location = /.well-known/oauth-authorization-server/auth/realms/helmglass {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $public_scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass http://helm_identity/auth/realms/helmglass/.well-known/oauth-authorization-server;
    }
    location /.well-known/ {
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_pass http://helm_api;
    }
    location = /mcp {
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header Cookie "";
        proxy_set_header X-Helm-Channel MCP;
        proxy_pass http://helm_api;
    }
    location = /widget/events {
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 75s;
        proxy_pass http://helm_api;
    }
    location /api/events {
        include /etc/nginx/proxy-api.conf;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_cache off;
    }
    location /api/ {
        include /etc/nginx/proxy-api.conf;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
    location /browser/ {
        if ($uri !~ "^/browser/(novnc/|sessions/[0-9a-f-]+/view$)") { return 404; }
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header X-Worker-Token "";
        proxy_read_timeout 75s;
        proxy_buffering off;
        proxy_pass http://helm_browser/;
    }
    location / {
        proxy_set_header Host $host;
        proxy_pass http://helm_frontend;
    }
}
