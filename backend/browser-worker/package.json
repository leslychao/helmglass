    "playwright": "1.64.0-alpha-1790635538000",
    "undici": "8.11.2",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3"
  }
}
