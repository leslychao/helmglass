#!/bin/bash
set -eu

# The JRE image includes Bash and coreutils; no additional HTTP client is required.
exec timeout 5 bash -c '
  exec 3<>/dev/tcp/127.0.0.1/8080
  printf "GET /actuator/health HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n" >&3
  IFS= read -r status <&3
  [[ "$status" == "HTTP/1.1 200 "* ]]
'
