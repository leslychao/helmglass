  <changeSet id="3-control-intents" author="helmglass">
    <sql>ALTER TABLE browser_sessions ADD COLUMN pending_control jsonb;
      ALTER TABLE browser_sessions ADD COLUMN artifact_cursor bigint NOT NULL DEFAULT 0;
      ALTER TABLE browser_sessions ADD COLUMN pending_connection_id uuid REFERENCES connections(id);
      CREATE UNIQUE INDEX browser_pending_connection ON browser_sessions(pending_connection_id)
        WHERE pending_connection_id IS NOT NULL AND status NOT IN ('CLOSED','LOST');
      ALTER TABLE operations ADD COLUMN requested_control_epoch bigint;
      ALTER TABLE accounts ADD COLUMN administrator boolean NOT NULL DEFAULT false;</sql>
    <sql>ALTER TABLE accounts ADD COLUMN mcp_connected_at timestamptz;</sql>
  </changeSet>
