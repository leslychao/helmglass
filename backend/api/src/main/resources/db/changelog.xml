  <changeSet id="6-continuation-request-time" author="helmglass">
    <sql>ALTER TABLE mcp_chats ADD COLUMN continuation_requested_at timestamptz;
      UPDATE mcp_chats SET continuation_requested_at=updated_at
        WHERE continuation_status&lt;&gt;'IDLE';</sql>
