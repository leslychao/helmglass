    }
  },
  "required": [
    "schemaVersion",
    "workerId",
    "bootId",
    "certificatePem",
    "caPem",
    "expiresAt"
  ],
  "additionalProperties": false,
  "$id": "urn:helmglass:worker:v1:enrollment-response",
