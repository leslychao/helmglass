{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "installationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "workerId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "bootId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "capacity": {
      "type": "number",
      "const": 1
    },
    "enrollmentToken": {
      "type": "string",
      "minLength": 32,
      "maxLength": 512
    },
    "csrPem": {
      "type": "string",
      "minLength": 100,
      "maxLength": 16384
    }
  },
  "required": [
    "schemaVersion",
    "installationId",
    "workerId",
    "bootId",
    "capacity",
    "enrollmentToken",
    "csrPem"
  ],
  "additionalProperties": false,
  "$id": "urn:helmglass:worker:v1:enrollment-request",
  "$comment": "Generated by backend/worker-protocol/generate.mjs from the strict worker boundary schemas. Do not edit manually."
}
