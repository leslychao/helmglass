+// INCR chunks are acknowledged by deleting the transfer property. Retain only
+// the bounded prefix needed to accept text or report overflow; drain the rest.
+void XSelection::handleEvent(TXWindow* /* window */, XEvent* event)
+{
+  if (!receivingIncremental || event->type != PropertyNotify ||
+      event->xproperty.atom != transferProperty ||
+      event->xproperty.state != PropertyNewValue)
+    return;
+
+  Atom type = None;
+  int format = 0;
+  unsigned long count = 0, after = 0;
+  unsigned char* data = nullptr;
+  size_t remaining = maxSelectionBytes - incrementalData.size();
+  long units = discardingIncremental ? 16384 : (remaining + 3) / 4;
+  int status = XGetWindowProperty(dpy, win(), transferProperty, 0, units, True,
+                                  AnyPropertyType, &type, &format, &count, &after, &data);
+  if (status != Success) {
+    receivingIncremental = false;
+    incrementalData.clear();
+    if (data)
+      XFree(data);
+    return;
+  }
+  XDeleteProperty(dpy, win(), transferProperty);
+
+  if (format != 8 || type != incrementalTarget) {
+    receivingIncremental = false;
+    incrementalData.clear();
+  } else if (!discardingIncremental) {
+    size_t accepted = std::min((size_t)count, remaining);
+    if (accepted)
+      incrementalData.append((const char*)data, accepted);
+    if (count == 0 || after || count > remaining ||
+        incrementalData.size() == maxSelectionBytes) {
+      XSelectionEvent reply = {};
+      reply.target = incrementalTarget;
+      reply.property = transferProperty;
+      selectionNotify(&reply, type, 8, (int)incrementalData.size(),
+                       (void*)incrementalData.data());
+      incrementalData.clear();
+      discardingIncremental = count != 0;
+    }
+  }
+  if (count == 0)
+    receivingIncremental = false;
+  if (data)
+    XFree(data);
+  XFlush(dpy);
+}
