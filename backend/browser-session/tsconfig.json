{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "outDir": "dist", "rootDir": "src",
    "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
