#!/bin/sh
set -eu
umask 077

fail() { printf '%s\n' "$1" >&2; exit 1; }
[ "$#" = 3 ] || fail 'Usage: backup-crypto encrypt|decrypt input-file new-output-file'
operation=$1
input=$2
output=$3
case "$operation" in encrypt|decrypt) ;; *) fail 'Unsupported backup crypto operation.' ;; esac
[ -f "$input" ] && [ ! -L "$input" ] || fail 'Backup input must be a regular file.'
[ ! -e "$output" ] && [ ! -L "$output" ] || fail 'Backup crypto output already exists.'
directory=$(dirname -- "$output")
[ -d "$directory" ] && [ ! -L "$directory" ] || fail 'Backup output directory is invalid.'
permissions=$(stat -c %a -- "$directory")
[ "$((0$permissions & 077))" = 0 ] || fail 'Backup output directory must be private.'
limit=${BACKUP_CRYPTO_TIMEOUT_SECONDS:-3600}
case "$limit" in ''|*[!0-9]*) fail 'Invalid crypto timeout.' ;; esac
[ "$limit" -ge 1 ] && [ "$limit" -le 86400 ] || fail 'Invalid crypto timeout.'
temporary=$(mktemp "$directory/.crypto.XXXXXXXX")
trap 'rm -f -- "$temporary"' EXIT HUP INT TERM

if [ "$operation" = encrypt ]; then
  : "${BACKUP_RECIPIENT_CERT:?Backup recipient certificate file is required}"
  [ -f "$BACKUP_RECIPIENT_CERT" ] && [ ! -L "$BACKUP_RECIPIENT_CERT" ] || fail 'Backup recipient certificate is invalid.'
  timeout --kill-after=5s "$limit" openssl cms -encrypt -binary -stream -outform DER \
    -aes-256-gcm -in "$input" -out "$temporary" -recip "$BACKUP_RECIPIENT_CERT" 2>/dev/null \
    || fail 'Backup encryption failed.'
else
  : "${BACKUP_PRIVATE_KEY_FILE:?Protected backup private key file is required}"
  : "${BACKUP_KEY_PASSWORD_FILE:?Protected backup key password file is required}"
  for secret in "$BACKUP_PRIVATE_KEY_FILE" "$BACKUP_KEY_PASSWORD_FILE"; do
    [ -f "$secret" ] && [ ! -L "$secret" ] || fail 'Backup recovery credential is invalid.'
    permissions=$(stat -c %a -- "$secret")
    [ "$((0$permissions & 077))" = 0 ] || fail 'Backup recovery credential must be private.'
  done
  grep -Eq '^-----BEGIN ENCRYPTED PRIVATE KEY-----[[:space:]]*$' "$BACKUP_PRIVATE_KEY_FILE" \
    || fail 'Recovery requires an encrypted PKCS8 private key.'
  # OpenSSL also decrypts unauthenticated CMS modes. Accept only our AEAD format.
  # Stop at the algorithm header so ciphertext is neither logged nor hex-dumped.
  if ! timeout --kill-after=5s "$limit" openssl cms -cmsout -print -inform DER \
    -in "$input" 2>/dev/null | awk '
      NR == 2 && $0 == "  contentType: id-smime-ct-authEnvelopedData (1.2.840.113549.1.9.16.1.23)" { authenticated = 1 }
      $0 == "      contentEncryptionAlgorithm: " { algorithm = 1; next }
      algorithm {
        accepted = authenticated && $0 == "        algorithm: aes-256-gcm (2.16.840.1.101.3.4.1.46)"
        exit
      }
      NR > 256 { exit }
      END { exit !accepted }
    '; then
    fail 'Backup must use CMS AuthEnvelopedData with AES-256-GCM.'
  fi
  timeout --kill-after=5s "$limit" openssl cms -decrypt -binary -inform DER \
    -in "$input" -out "$temporary" -inkey "$BACKUP_PRIVATE_KEY_FILE" \
    -passin "file:$BACKUP_KEY_PASSWORD_FILE" 2>/dev/null || fail 'Backup authentication or decryption failed.'
fi

# In particular, decrypted bytes never become the caller's output before GCM succeeds.
sync -f "$temporary"
ln -- "$temporary" "$output" || fail 'Backup crypto output could not be published.'
sync -f "$directory"
