#!/bin/sh
set -eu
umask 077
export LC_ALL=C PGCONNECT_TIMEOUT=5
fail() { printf '%s\n' "$1" >&2; exit 1; }
[ "$#" = 4 ] || fail 'Usage: recover-and-stop PGDATA system-identifier target-name target-lsn'
data=$1
system=$2
point=$3
lsn=$4
case "$system" in ''|*[!0-9]*) fail 'Invalid cluster identity.' ;; esac
printf '%s\n' "$point" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$' || fail 'Invalid restore point name.'
printf '%s\n' "$lsn" | grep -Eq '^[0-9A-F]{1,8}/[0-9A-F]{1,8}$' || fail 'Invalid restore point LSN.'
for directory in "$data" /var/run/postgresql; do
  [ -d "$directory" ] && [ ! -L "$directory" ] || fail 'Recovery directory is unavailable.'
  [ "$(stat -c %u "$directory")" = "$(id -u)" ] || fail 'Recovery directory has a different owner.'
  permissions=$(stat -c %a "$directory")
  [ "$((0$permissions & 077))" = 0 ] || fail 'Recovery directory must be private.'
done
actual=$(pg_controldata "$data" | sed -n 's/^Database system identifier: *//p')
[ "$actual" = "$system" ] || fail 'Recovery cluster identity mismatch.'
[ -f "$data/recovery.signal" ] && [ ! -L "$data/recovery.signal" ] || fail 'Recovery signal is missing; reconcile any prior promotion.'
[ ! -e "$data/.helm-pitr-receipt.json" ] || fail 'Recovery receipt already exists.'
[ -f "$data/postgresql.auto.conf.helm-original" ] && [ ! -L "$data/postgresql.auto.conf.helm-original" ] \
  || fail 'Original PostgreSQL settings are unavailable.'
cmp -s "$data/postgresql.auto.conf" - <<EOF || fail 'Recovery settings were modified outside their owner.'
listen_addresses = ''
archive_mode = off
restore_command = '/opt/helm/bin/restore-wal "%f" "%p"'
recovery_target_name = '$point'
recovery_target_action = 'pause'
EOF
[ "$(postgres -D "$data" -C recovery_target_name)" = "$point" ] || fail 'Configured restore point mismatch.'
[ "$(postgres -D "$data" -C recovery_target_action)" = pause ] || fail 'Recovery must pause at its target.'
if pg_ctl -D "$data" status >/dev/null 2>&1; then fail 'Recovery cluster is already running.'; fi

running=false
cleanup() {
  if [ "$running" = true ]; then pg_ctl -D "$data" --mode fast --wait --timeout 30 stop >/dev/null; fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
export PGHOST=/var/run/postgresql PGPORT=5432 PGUSER=postgres PGDATABASE=postgres
sql() {
  timeout --kill-after=5s 40 psql --no-psqlrc --no-password --quiet --tuples-only --no-align \
    --set ON_ERROR_STOP=1 --set target="$point" --set target_lsn="$lsn" --set system_identifier="$system"
}
running=true
pg_ctl -D "$data" --log "$data/helm-recovery.log" --wait --timeout 60 \
  --options "-c listen_addresses='' -c unix_socket_directories='/var/run/postgresql' -c port=5432" start >/dev/null
deadline=$(($(date +%s) + 300))
while :; do
  state=$(printf '%s\n' "SELECT pg_get_wal_replay_pause_state();" | sql)
  [ "$state" = paused ] && break
  [ "$(date +%s)" -lt "$deadline" ] || fail 'Recovery did not reach the target within 300 seconds.'
  sleep 0.25
done
verified=$(sql <<'SQL'
SELECT pg_is_in_recovery()
  AND pg_get_wal_replay_pause_state() = 'paused'
  AND current_setting('recovery_target_name') = :'target'
  AND current_setting('recovery_target_action') = 'pause'
  AND current_setting('listen_addresses') = ''
  AND pg_last_wal_replay_lsn() = :'target_lsn'::pg_lsn
  AND (SELECT system_identifier::text FROM pg_control_system()) = :'system_identifier';
SQL
)
[ "$verified" = t ] || fail 'Paused recovery does not match the exact cluster, restore point and LSN.'
promoted=$(printf '%s\n' 'SELECT pg_promote(true, 30);' | sql)
[ "$promoted" = t ] || fail 'Promotion was not confirmed; reconcile before retrying.'
primary=$(printf '%s\n' "SELECT NOT pg_is_in_recovery() AND current_setting('listen_addresses') = '';" | sql)
[ "$primary" = t ] || fail 'Isolated primary state was not confirmed.'
pg_ctl -D "$data" --mode fast --wait --timeout 30 stop >/dev/null
running=false
[ "$(pg_controldata "$data" | sed -n 's/^Database cluster state: *//p')" = 'shut down' ] \
  || fail 'Clean database shutdown was not confirmed.'
# Normal startup is still the launcher's admission decision. Restore only the
# original settings after the isolated primary has stopped successfully.
mv -T -- "$data/postgresql.auto.conf.helm-original" "$data/postgresql.auto.conf"
receipt=$(mktemp "$data/.helm-pitr-receipt.XXXXXXXX")
jq -cn --arg system "$system" --arg point "$point" --arg lsn "$lsn" \
  '{schemaVersion:1,systemIdentifier:$system,targetName:$point,targetLsn:$lsn,state:"PROMOTED_AND_STOPPED"}' > "$receipt"
sync -f "$receipt"
ln "$receipt" "$data/.helm-pitr-receipt.json"
rm -- "$receipt"
sync -f "$data"
cat "$data/.helm-pitr-receipt.json"
