# The single installation on 107 serves as dev and production. Fill in its deployment values.
# No passwords, root tokens or private keys belong in this file.
DOCKER_HOST=tcp://192.168.0.107:2375
INSTALLATION_ID=helm-glass-dev
PUBLIC_ORIGIN=https://helmg.ru
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
TRUSTED_EDGE_PROXY=172.30.242.2
WORKER_COUNT=2
GPU_DEVICE_ID=0

# These are separate paths when the Docker daemon runs on another computer.
LOCAL_SECRETS_DIR=C:/Users/operator/.helm-glass/dev/secrets
SECRETS_DIR=/srv/helm-glass/dev/secrets
# Optional protected JSON on the operator workstation, outside Git and LOCAL_SECRETS_DIR.
# Only KEYCLOAK_ADMIN_PASSWORD, KEYCLOAK_ANGELINA_PASSWORD and VAULT_CUSTODY_PASSWORD.
OPERATOR_INPUT_FILE=
# Operator workstation files, never daemon paths. TLS PEM contains certificate chain and key.
EDGE_TLS_FILE=C:/Users/operator/.helm-glass/certificates/edge.pem
TURN_TLS_FILE=C:/Users/operator/.helm-glass/certificates/turn.pem
# Encrypted recovery material is kept off the Docker host, separately from bootstrap files.
LOCAL_RECOVERY_DIR=C:/Users/operator/.helm-glass/recovery
# Separate persistent directory on 107, excluded from backup rollback.
# Contains .helm-ledger.json with schemaVersion=1 and this INSTALLATION_ID; mode0700, uid10001.
DELETION_LEDGER_DIR=/srv/helm-glass/dev/ledger
# Existing protected directories writable by the pinned PostgreSQL image's postgres user (uid999).
# Backups stay on 107; this does not protect against loss of the host or its disks.
# Scratch must reside on encrypted storage.
BACKUP_DIR=/srv/helm-glass/dev/backup
BACKUP_WORK_DIR=/srv/helm-glass/dev/backup-work
# Public RSA3072+ recipient certificate only. Keep its encrypted private key off the source host.
BACKUP_RECIPIENT_FILE=
# Existing persistent local data directory on the Docker host: mode0700, uid10001.
MINIO_DATA_DIR=/srv/helm-glass/dev/minio

TURN_INTERNAL_URL=turn:coturn:3478?transport=tcp
TURN_PUBLIC_URLS=turn:192.168.0.107:3478?transport=udp,turns:helmg.ru:5349?transport=tcp
TURN_REALM=helmg.ru
TURN_ADVERTISED_IP=192.168.0.107
TURN_BIND_ADDRESS=192.168.0.107
TURN_RELAY_MIN=49160
TURN_RELAY_MAX=49259

# Required real, operator-confirmed profile data. Passwords are supplied through protected input.
KEYCLOAK_ADMIN_EMAIL=
KEYCLOAK_ADMIN_LAST_NAME=
KEYCLOAK_ANGELINA_EMAIL=
KEYCLOAK_ANGELINA_LAST_NAME=
MCP_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
